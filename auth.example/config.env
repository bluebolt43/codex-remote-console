# Copy this file to auth/config.env, then replace every value inside < >.
AUTH_ENABLED=true
ALLOW_PERSISTENT_APPROVALS=false
REQUESTS_PER_MINUTE=180
MAX_CONNECTIONS=200
MAX_SSE_CONNECTIONS=50
MAX_SSE_CONNECTIONS_PER_IP=5
UPLOADS_PER_15_MINUTES=20
MAX_THREAD_UPLOAD_MB=64
MAX_TOTAL_UPLOAD_MB=512
PASSKEY_RP_ID=<YOUR_DOMAIN>
PASSKEY_ORIGIN=https://<YOUR_DOMAIN>:<HTTPS_PORT>
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=<HTTPS_PORT>
TLS_CERT_FILE=<ABSOLUTE_PATH_TO_CERTIFICATE>
TLS_KEY_FILE=<ABSOLUTE_PATH_TO_PRIVATE_KEY>
